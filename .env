# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mydb
DB_MIN_CONN=2
DB_MAX_CONN=10

# Device
DEVICE_ID=device_001

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=secret
MQTT_USE_TLS=false

# Logger
LOGGER_LEVEL=20

# HTTP Server
HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=8000
HTTP_SERVER_GRACE_PERIOD=10
HTTP_SERVER_REQUEST_TIMEOUT_PERIOD=30
HTTP_SERVER_API_KEY=secret

# JWT
JWT_ALLOWED_ALGS=HS256
JWT_ISSUER=my-app
JWT_SECRET_KEY=super-secret
JWT_TOKEN_DURATION=3600